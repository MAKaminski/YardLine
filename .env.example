# YardLine environment
# Copy to .env.local for local dev. Set the same values in Vercel for production.

# Supabase — public, safe to expose to the browser (RLS gates all access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Where magic-link emails send the rep back to.
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeder only (never shipped to the browser). Needed to bypass RLS when writing
# yards from scripts/seed-yards.ts. Get it from Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Honest crawler identity — required by SCRAPING_POLICY.md.
SEEDER_USER_AGENT="YardLineBot/0.1 (+mailto:michael@modularequity.com)"
